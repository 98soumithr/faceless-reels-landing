# Waitlist destination.
#
# Copy this file to `.env.local` and replace the value with your real form
# endpoint. Any service that accepts a JSON POST works — Formspree, Tally,
# ConvertKit, Mailchimp, Formspark.
#
#   Formspree : https://formspree.io/f/<your-form-id>
#   Tally     : https://api.tally.so/r/<your-form-id>
#
# The form POSTs { email, source, timestamp }, where `source` is "hero" or
# "closing" so you can see which section converts.
#
# While this still says REPLACE_ME the form short-circuits in dev (so the page
# stays demoable) and shows an error in production rather than silently
# dropping signups.
NEXT_PUBLIC_WAITLIST_ENDPOINT=https://formspree.io/f/REPLACE_ME
